# central-config environment variables.
#
# Copy to .env for local development. .env is gitignored and must stay that way.
# In production inject these through Kubernetes secrets/configmaps or your
# secret store — do not ship a populated .env in an image.
#
# Every value below is a dummy. Defaults shown in [brackets] are what the
# process uses when the variable is unset.

# ---------------------------------------------------------------------------
# Storage — the source of truth
# ---------------------------------------------------------------------------

# "oracle" for production, "sqlite" for the local test stack
# (internal/database/sqlite.go). [oracle]
DB_DRIVER=sqlite

# Oracle DSN when DB_DRIVER=oracle:
#   oracle://USER:PASSWORD@host:1521/SERVICE_NAME
# SQLite file path when DB_DRIVER=sqlite. []
CONN_STRING=file:./central-config.db?_pragma=busy_timeout(5000)

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

# Listen address for the admin API. [:8080]
PORT=:8080

# ---------------------------------------------------------------------------
# Messaging / JetStream — the distribution plane
# ---------------------------------------------------------------------------

# Set true to write through to KV on every admin write and run the reconciler.
# With this false the service is a database-backed CRUD API and nothing is
# distributed. [false]
PUBLISH_ENABLED=true

# NATS server or cluster address. []
NATS_URL=nats://localhost:4222

# Optional path to a NATS .creds file (NKEY/JWT). Empty means no NATS auth,
# which is dev-only. []
NATS_CREDS=

# KV bucket replica count: 1 for single-node dev, 3 for a production cluster.
# Only applied when the bucket is created. [1]
NATS_REPLICAS=1

# How often the reconciler resyncs the database to KV and heals drift. Go
# duration syntax. [5m]
RECONCILE_INTERVAL=5m

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Named tokens, comma separated: NAME:ENV_SCOPE:SECRET
#   ENV_SCOPE is "*" for all environments, or environment ids joined by "|".
# The name is recorded as the actor on every audit row.
# Example (dummy secrets — generate your own):
#   ADMIN_TOKENS=alice:*:CHANGE_ME_ADMIN,ci-dev:1|2:CHANGE_ME_CI
ADMIN_TOKENS=

# The single shared token, recorded as the "shared" full-scope actor.
# If both this and ADMIN_TOKENS are empty, write auth is
# DISABLED and the service logs a warning at startup — dev only. []
ADMIN_TOKEN=change-me-local-dev-token

# Writes allowed per caller per minute; <= 0 disables the limiter. [120]
WRITE_RATE_LIMIT_PER_MINUTE=120

# When both are set the admin API serves HTTPS. Otherwise plain HTTP with a
# startup warning — acceptable only behind a TLS-terminating ingress. []
TLS_CERT_FILE=
TLS_KEY_FILE=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# debug | info | warn | error [info]
LOG_LEVEL=info

# "json" emits ECS documents for Elasticsearch; "text" is the readable
# local-development shape. [json]
LOG_FORMAT=text

# Stamped onto every log line. [central-config] / [dev]
SERVICE_NAME=central-config
SERVICE_VERSION=dev

# ---------------------------------------------------------------------------
# Test console (cmd/testconsole) — local stack only, not the service
# ---------------------------------------------------------------------------

# The console plays a consuming microservice: it holds a live configclient
# cache and serves a browser UI showing that cache update in real time.

# Environment id the console's consumer watches. [1]
ENVIRONMENT_ID=1

# Admin API the console proxies its writes to. [http://localhost:8080]
CENTRAL_CONFIG_URL=http://localhost:8080

# Run a JetStream server inside the console process, so the stack works without
# Docker. The compose stack leaves this off and uses the nats container. [false]
NATS_EMBEDDED=false

# Directory holding the built React bundle (webui/ builds to web/). [web]
WEB_DIR=web

# The console also reads NATS_URL, ADMIN_TOKEN and PORT. In the compose stack
# it listens on :8090; set PORT accordingly when running it alongside the
# service on one machine.
