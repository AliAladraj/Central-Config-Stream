*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Test console UI: node_modules and the built bundle are not checked in.
node_modules/
webui/node_modules/
/web/
